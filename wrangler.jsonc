{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "this-is-a-good-one",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "fc5e0e09-ab4b-4dcc-9004-24857b5a846a","database_name": "this-is-a-good-one" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "16083039a7c240e7b72ed936e0a3a75d" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
